  "Palestine":       { "folder": "asia",          "cell": "de-facto-recognized", "iso": "PS" },

  "Iraqi Kurdistan": { "folder": "asia",          "cell": "asymmetric-autonomy", "geonameId": 126585,  "pop": 6000000 },
