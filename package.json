{
  "name": "custom-wordlists",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build custom word lists for skribbl.io and similar word games.",
  "scripts": {
    "dev": "npm run build:index && vite",
    "build": "npm run build:index && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "build:index": "node scripts/build-index.mjs",
    "validate": "node scripts/validate-data.mjs",
    "check:wraps": "node scripts/check-wraps.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.7",
    "ajv": "^8.17.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
